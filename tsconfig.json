{
  "compilerOptions": {
    "lib": ["ES2023", "dom"],
    "module": "Node20",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src"],
  "ts-node": {
    "compilerOptions": {
      "rootDir": ".",
      "strict": false,
      "types": ["node", "mocha", "sinon-chai"]
    }
  }
}
